NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CONTACT_EMAIL=

# Local development only. Point the app at the Firestore emulator
# (`npm run emulator`) so browser reads and writes never reach the production
# project. Also set NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-gdg-tum-site, because the
# emulator stores each project id in its own namespace. Leave both unset for
# production builds; the app refuses to start if the host is set in a
# production build.
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
