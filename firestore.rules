rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return isSignedIn() && role() == "admin"; }
    function isLeadOf(trackId) { return isSignedIn() && role() == "lead" && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.track == trackId; }

    function writeupOf(writeupId) {
      return get(/databases/$(database)/documents/writeups/$(writeupId));
    }
    function eventTrackId(eventId) {
      let e = get(/databases/$(database)/documents/events/$(eventId));
      return e != null ? e.data.trackId : "";
    }
    // Admin, or a lead of the track the ticker's event belongs to.
    function canManageTicker(eventId) {
      return isAdmin() || (isSignedIn() && isLeadOf(eventTrackId(eventId)));
    }

    function canManageMedia(writeupId) {
      let w = writeupOf(writeupId);
      return w != null && (
        isAdmin()
        || (isSignedIn() && w.data.authorId == request.auth.uid)
        || (isSignedIn() && isLeadOf(w.data.trackId))
      );
    }

    match /tracks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin() || isLeadOf(request.resource.data.trackId);
      // Both sides must be the actor's track: a lead can neither push an event out
      // of their track nor pull one in and inherit the other track's lead rights.
      // A lead may only stamp cancelledBy with their own uid.
      allow update: if isAdmin() || (isLeadOf(resource.data.trackId) && isLeadOf(request.resource.data.trackId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cancelledBy"])
            || request.resource.data.cancelledBy == request.auth.uid));
      // Leads cancel (a status write); only an admin may destroy an event.
      allow delete: if isAdmin();
    }
    match /ticker/{id} {
      allow read: if true;
      // Only the entry's creator may create/update/remove it, and only for an
      // event in their own track; admins manage any ticker row. Messages are
      // capped at 140 characters.
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && canManageTicker(request.resource.data.eventId) && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 140;
      allow update: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid && canManageTicker(resource.data.eventId) && request.resource.data.message is string && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 140);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid && canManageTicker(resource.data.eventId));
    }
    match /posts/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid} {
      // Public user docs hold no email; emails live in private_users.
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == "member";
      allow update: if (isSignedIn() && request.auth.uid == uid && !request.resource.data.diff(resource.data).changedKeys().hasAny(["role","track"])) || isAdmin();
      allow delete: if isAdmin();
    }
    match /private_users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
    match /writeups/{id} {
      allow read: if resource.data.status == "published" || (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      // Admin may create any writeup; a lead may create a draft or published
      // writeup in their own track, attributed to themselves.
      allow create: if isSignedIn() && (
        isAdmin()
        || (role() == "lead" && request.resource.data.authorId == request.auth.uid && request.resource.data.trackId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.track && (request.resource.data.status == "draft" || request.resource.data.status == "published"))
      );
      // Admin may update anything; a lead author may update their own writeup
      // as long as authorId and trackId are unchanged (status may change).
      allow update: if isAdmin() || (isSignedIn() && role() == "lead" && resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId && request.resource.data.trackId == resource.data.trackId);
      allow delete: if isAdmin();
    }
    match /media/{id} {
      allow read: if writeupOf(resource.data.writeupId).data.status == "published" || isAdmin() || (isSignedIn() && writeupOf(resource.data.writeupId).data.authorId == request.auth.uid);
      allow create: if isSignedIn() && canManageMedia(request.resource.data.writeupId);
      allow update: if isSignedIn() && canManageMedia(resource.data.writeupId);
      allow delete: if isSignedIn() && canManageMedia(resource.data.writeupId);
    }
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
