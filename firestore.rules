rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function role() {
      return isSignedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data.get("role", "")
        : "";
    }
    function isAdmin() { return role() == "admin"; }
    function isLeadOf(trackId) {
      return role() == "lead"
        && get(userPath(request.auth.uid)).data.get("track", "") == trackId;
    }

    function eventPath(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    function eventTrackId(eventId) {
      return get(eventPath(eventId)).data.get("trackId", "");
    }
    function canManageTicker(eventId) {
      return exists(eventPath(eventId)) && (isAdmin() || isLeadOf(eventTrackId(eventId)));
    }
    function validTickerMessage(data) {
      return data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 140;
    }

    function writeupPath(writeupId) { return /databases/$(database)/documents/writeups/$(writeupId); }
    function writeupExists(writeupId) { return exists(writeupPath(writeupId)); }
    function writeupData(writeupId) { return get(writeupPath(writeupId)).data; }
    function canEditDraftMedia(writeupId) {
      let before = get(writeupPath(writeupId)).data;
      let after = getAfter(writeupPath(writeupId)).data;
      return (isAdmin() || before.get("authorId", "") == request.auth.uid)
        && before.get("status", "") == "draft"
        && after.get("status", "") == "draft"
        && after.get("reviewed", false) == false
        && (!after.get("aiDrafted", false) || after.get("aiReviewed", false) == false);
    }
    function isWriteupAuthor(writeupId) {
      return isSignedIn() && writeupExists(writeupId)
        && writeupData(writeupId).get("authorId", "") == request.auth.uid;
    }
    function canManageMedia(writeupId) {
      return isAdmin() || isWriteupAuthor(writeupId);
    }

    match /tracks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create: if isAdmin() || isLeadOf(request.resource.data.trackId);
      allow update: if isAdmin() || (
        isLeadOf(resource.data.trackId)
        && isLeadOf(request.resource.data.trackId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["cancelledBy"])
          || request.resource.data.cancelledBy == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    match /ticker/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.eventId is string
        && validTickerMessage(request.resource.data)
        && canManageTicker(request.resource.data.eventId);
      allow update: if request.resource.data.eventId == resource.data.eventId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status in ["active", "inactive"]
        && validTickerMessage(request.resource.data)
        && canManageTicker(resource.data.eventId);
      allow delete: if isAdmin() || (
        isSignedIn() && exists(eventPath(resource.data.eventId))
        && isLeadOf(eventTrackId(resource.data.eventId))
      );
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(["email"])
        && request.resource.data.get("role", "") == "member";
      allow update: if !request.resource.data.keys().hasAny(["email"]) && (
        (isSignedIn() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "track"]))
        || (isAdmin() && (
          request.auth.uid != uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "track"])
        ))
      );
      allow delete: if isAdmin();
    }

    match /private_users/{uid} {
      allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    function hasRequiredWriteupReview(data) {
      return data.get("status", "draft") != "published" || (
        data.get("reviewed", false) == true
        && data.get("reviewedBy", "") is string
        && data.get("reviewedBy", "").size() > 0
        && data.get("reviewedAt", null) is timestamp
        && (!data.get("aiDrafted", false) || (
          data.get("aiReviewed", false) == true
          && data.get("aiReviewedBy", "") is string
          && data.get("aiReviewedBy", "").size() > 0
          && data.get("aiReviewedAt", null) is timestamp
        ))
      );
    }

    function writeupContentChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "eventId", "title", "summary", "body", "attendance", "links", "tags"
      ]);
    }

    function requiresFreshWriteupReview() {
      return request.resource.data.get("status", "draft") == "published"
        && (
          resource.data.get("status", "draft") != "published"
          || writeupContentChanged()
        );
    }

    function hasFreshWriteupReview() {
      return (
        !writeupContentChanged()
        || !request.resource.data.get("reviewed", false)
        || (
          request.resource.data.get("reviewedBy", "") == request.auth.uid
          && request.resource.data.get("reviewedAt", null) == request.time
        )
      ) && (
        !requiresFreshWriteupReview()
        || (
          request.resource.data.get("reviewed", false) == true
          && request.resource.data.get("reviewedBy", "") == request.auth.uid
          && request.resource.data.get("reviewedAt", null) == request.time
        )
      );
    }

    function requiresFreshAIWriteupReview() {
      return request.resource.data.get("status", "draft") == "published"
        && request.resource.data.get("aiDrafted", false)
        && (
          !resource.data.get("aiDrafted", false)
          || writeupContentChanged()
        );
    }

    function hasFreshAIWriteupReview() {
      return (
        !writeupContentChanged()
        || !request.resource.data.get("aiReviewed", false)
        || (
          request.resource.data.get("aiReviewedBy", "") == request.auth.uid
          && request.resource.data.get("aiReviewedAt", null) == request.time
        )
      ) && (
        !requiresFreshAIWriteupReview()
        || (
          request.resource.data.get("aiReviewed", false) == true
          && request.resource.data.get("aiReviewedBy", "") == request.auth.uid
          && request.resource.data.get("aiReviewedAt", null) == request.time
        )
      );
    }

    function hasCallerReviewOnCreate(data) {
      return (
        !data.get("reviewed", false)
        || (
          data.get("reviewedBy", "") == request.auth.uid
          && data.get("reviewedAt", null) == request.time
        )
      ) && (
        !data.get("aiReviewed", false)
        || (
          data.get("aiReviewedBy", "") == request.auth.uid
          && data.get("aiReviewedAt", null) == request.time
        )
      ) && (
        data.get("status", "draft") != "published"
        || (
          data.get("reviewed", false) == true
          && data.get("reviewedBy", "") == request.auth.uid
          && data.get("reviewedAt", null) == request.time
          && (!data.get("aiDrafted", false) || (
            data.get("aiReviewed", false) == true
            && data.get("aiReviewedBy", "") == request.auth.uid
            && data.get("aiReviewedAt", null) == request.time
          ))
        )
      );
    }

    match /writeups/{id} {
      allow read: if resource.data.get("status", "") == "published"
        || (isSignedIn() && (resource.data.get("authorId", "") == request.auth.uid || isAdmin()));
      allow create: if isSignedIn()
        && request.resource.data.status in ["draft", "published"]
        && hasRequiredWriteupReview(request.resource.data)
        && hasCallerReviewOnCreate(request.resource.data)
        && (
          isAdmin()
          || (isLeadOf(request.resource.data.trackId)
            && request.resource.data.authorId == request.auth.uid)
        );
      allow update: if isSignedIn()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.trackId == resource.data.trackId
        && request.resource.data.status in ["draft", "published"]
        && (!resource.data.get("aiDrafted", false) || request.resource.data.get("aiDrafted", false))
        && hasRequiredWriteupReview(request.resource.data)
        && hasFreshWriteupReview()
        && hasFreshAIWriteupReview()
        && (isAdmin() || (
          isLeadOf(resource.data.trackId)
          && resource.data.authorId == request.auth.uid
        ));
      allow delete: if isAdmin();
    }

    match /media/{id} {
      allow read: if isAdmin() || (
        writeupExists(resource.data.writeupId) && (
          writeupData(resource.data.writeupId).get("status", "") == "published"
          || isWriteupAuthor(resource.data.writeupId)
        )
      );
      // Published writeups are immutable from the media editor. Unpublish first,
      // then update captions, alt text, uploads or removals and review again.
      allow create: if isSignedIn()
        && canEditDraftMedia(request.resource.data.writeupId);
      allow update: if isSignedIn()
        && request.resource.data.writeupId == resource.data.writeupId
        && canEditDraftMedia(resource.data.writeupId);
      // Admins may remove media records as part of deleting a parent writeup.
      // Individual media removal from a draft must invalidate its parent review.
      allow delete: if isSignedIn()
        && (
          (isAdmin() && !existsAfter(writeupPath(resource.data.writeupId)))
          || canEditDraftMedia(resource.data.writeupId)
        );
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}