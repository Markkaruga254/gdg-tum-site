{
  "name": "gdg-tum-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npx tsx scripts/seed.ts",
    "provision:leadership": "npx tsx scripts/provision-production-leadership.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:e2e:ci": "bash scripts/e2e-run.sh",
    "emulator": "firebase emulators:start --only firestore --project demo-gdg-tum-site",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gdg-tum-site \"node scripts/test-rules.mjs\"",
    "import:gdg-events": "npx tsx scripts/import-gdg-events.ts"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
